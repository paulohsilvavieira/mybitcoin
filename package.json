{
  "name": "mybitcoin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "api:build": "pnpm --filter mybitcoin-api build",
    "api:format": "pnpm --filter mybitcoin-api format",
    "api:start": "pnpm --filter mybitcoin-api start",
    "api:start:dev": "pnpm --filter mybitcoin-api start:dev",
    "api:start:debug": "pnpm --filter mybitcoin-api start:debug",
    "api:start:prod": "pnpm --filter mybitcoin-api start:prod",
    "api:lint": "pnpm --filter mybitcoin-api lint",
    "api:test": "pnpm --filter mybitcoin-api test",
    "api:test:watch": "pnpm --filter mybitcoin-api test:watch",
    "api:test:cov": "pnpm --filter mybitcoin-api test:cov",
    "api:test:debug": "pnpm --filter mybitcoin-api test:debug",
    "api:test:e2e": "pnpm --filter mybitcoin-api test:e2e",
    "api:prepare:test": "pnpm --filter mybitcoin-api prepare:test",
    "api:migration:create": "pnpm --filter mybitcoin-api migration:create",
    "api:migration:run": "pnpm --filter mybitcoin-api migration:run",
    "api:migration:dry-run": "pnpm --filter mybitcoin-api migration:dry-run",
    "api:migration:run:test": "pnpm --filter mybitcoin-api migration:run:test",
    "api:migration:dry-run:test": "pnpm --filter mybitcoin-api migration:dry-run:test",
    "api:seed:create": "pnpm --filter mybitcoin-api seed:create",
    "api:seed:run": "pnpm --filter mybitcoin-api seed:run",
    "api:seed:dry-run": "pnpm --filter mybitcoin-api seed:dry-run",
    "api:seed:run:test": "pnpm --filter mybitcoin-api seed:run:test",
    "api:seed:dry-run:test": "pnpm --filter mybitcoin-api seed:dry-run:test",
    "front:dev": "pnpm --filter mybitcoin-front dev",
    "front:build": "pnpm --filter mybitcoin-front build",
    "front:lint": "pnpm --filter mybitcoin-front lint",
    "front:preview": "pnpm --filter mybitcoin-front preview",
    "front:test": "pnpm --filter mybitcoin-front test",
    "front:test:watch": "pnpm --filter mybitcoin-front test:watch",
    "front:test:coverage": "pnpm --filter mybitcoin-front test:coverage",
    "app:start": "pnpm --filter mybitcoin-app start",
    "app:reset-project": "pnpm --filter mybitcoin-app reset-project",
    "app:android": "pnpm --filter mybitcoin-app android",
    "app:ios": "pnpm --filter mybitcoin-app ios",
    "app:web": "pnpm --filter mybitcoin-app web",
    "app:lint": "pnpm --filter mybitcoin-app lint"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
